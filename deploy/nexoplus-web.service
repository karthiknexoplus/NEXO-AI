[Unit]
Description=NEXOPLUS Web Studio (NEXOPLUS Automations)
Documentation=https://github.com/karthiknexoplus/NEXO-AI
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@/web
Environment=PORT=3080
Environment=OLLAMA_HOST=http://127.0.0.1:11434
Environment=WORKSPACE_ROOT=@REPO_ROOT@/web/workspace
# Cloud (fast on 4GB VPS): set OPENROUTER_API_KEY or GROQ_API_KEY — see deploy/nexoplus-cloud.env.example
# Environment=OPENROUTER_API_KEY=
# Environment=NEXO_INTELLIGENCE_PROVIDER=openrouter
# Local fallback (optional):
Environment=NEXO_MODEL=llama3.2:3b
Environment=NEXO_LIGHT=1
Environment=OLLAMA_NUM_THREADS=2
Environment=NEXO_OLLAMA_FALLBACK=true
ExecStart=/usr/bin/env node server.mjs
Restart=on-failure
RestartSec=5
# Logs: journalctl -u nexoplus-web -f

[Install]
WantedBy=multi-user.target
