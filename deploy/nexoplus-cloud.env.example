# Copy to /etc/nexoplus/env (or systemd drop-in) — never commit real keys.
#
# Fast cloud chat on a small VPS (no Ollama RAM). Free tiers have limits — not unlimited like local.

# Provider: openrouter | groq | custom | ollama (default: auto — cloud if key set)
# NEXO_INTELLIGENCE_PROVIDER=openrouter

# OpenRouter — https://openrouter.ai/keys (free models: openrouter/free)
OPENROUTER_API_KEY=sk-or-v1-...

# Groq — https://console.groq.com (generous free tier, rate limits)
# GROQ_API_KEY=gsk_...

# Custom OpenAI-compatible endpoint
# NEXO_OPENAI_BASE_URL=https://api.example.com/v1
# NEXO_API_KEY=...

# NEXO_PUBLIC_URL=https://ai.nexoplus.in
# NEXO_OLLAMA_FALLBACK=true
# NEXO_CLOUD_MODEL_FAST=meta-llama/llama-3.2-3b-instruct:free
# NEXO_CLOUD_MODEL_SMART=meta-llama/llama-3.2-3b-instruct:free
# NEXO_CLOUD_MODEL_DEEP=meta-llama/llama-3.2-3b-instruct:free

# Longer replies / big prompts (optional — provider may still cap free tiers)
# NEXO_MAX_OUTPUT_TOKENS=32768
# NEXO_MAX_OUTPUT_TOKENS_SMART=16384
# NEXO_OLLAMA_NUM_PREDICT=16384
# NEXO_OLLAMA_NUM_CTX=32768
# NEXO_MAX_REQUEST_BYTES=0
# NEXO_CLOUD_TIMEOUT_MS=600000

# Groq (alternative to OpenRouter)
# GROQ_API_KEY=gsk_...
# NEXO_INTELLIGENCE_PROVIDER=groq
# NEXO_CLOUD_MODEL_FAST=openai/gpt-oss-20b
# NEXO_CLOUD_MODEL_SMART=openai/gpt-oss-120b
