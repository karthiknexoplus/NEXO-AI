# Copy to /etc/nexoplus/env (or systemd drop-in) — never commit real keys.
#
# Fast cloud chat on a small VPS (no Ollama RAM). Free tiers have limits — not unlimited like local.

# Provider: openrouter | groq | custom | ollama (default: auto — cloud if key set)
# NEXO_INTELLIGENCE_PROVIDER=openrouter

# OpenRouter — https://openrouter.ai/keys (free models: openrouter/free)
OPENROUTER_API_KEY=sk-or-v1-...

# Groq — https://console.groq.com (generous free tier, rate limits)
# GROQ_API_KEY=gsk_...

# Custom OpenAI-compatible endpoint
# NEXO_OPENAI_BASE_URL=https://api.example.com/v1
# NEXO_API_KEY=...

# NEXO_PUBLIC_URL=https://ai.nexoplus.in
# NEXO_OLLAMA_FALLBACK=true
# NEXO_CLOUD_MODEL_FAST=openrouter/free
# NEXO_CLOUD_MODEL_SMART=openrouter/free
